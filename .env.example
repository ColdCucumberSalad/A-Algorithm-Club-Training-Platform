DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.example
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# Set to 0 only for local App API testing over HTTP.
APP_REQUIRE_HTTPS=1
# Add the actual private Nginx peer CIDR in Docker; never expose backend port 8000.
APP_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
POSTGRES_DB=club_platform
POSTGRES_USER=club
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# AstrBot plugin endpoint (blank disables notifications).
ASTRBOT_NOTIFY_URL=
# Configure each team's token and notification switches in the management workbench.
